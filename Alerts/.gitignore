# =============================================================================
# EVD17 Alerts — gitignore
# =============================================================================

# --- Codex / agent config (local only) --------------------------------------
/AGENTS.md
/.agents/
/.codex/
# -- Unfinished / draft / temporary files ------------------------------------------
/R/R/01b_alert_thresholds_epiweek.R

# --- Shiny app (separate project) -------------------------------------------
/ShinyApp.md

# --- Methodology notes (excluded from GitHub prep) --------------------------
# Local-only design notes; not redistributed with the public repo.
/docs/methodology/
/docs/plans/

# --- Datasets (never redistributed) -----------------------------------------
# The EVD line list, case data, population, GIS, and accessibility inputs
# are sensitive / external and MUST NOT be committed. The scripts read them
# from paths outside this repository (see README.md "Data dependencies").
# The rules below are a safety net against accidental local copies.
/data/
**/line_list*
**/linelist*
**/*line*list*.csv
**/*line*list*.xlsx
**/*line*list*.rds
**/evd.clean*
**/evd_case*
**/*accessibilit*.xlsx
**/*.gpkg
**/*.shp
**/*.geojson

# --- Analysis outputs (regenerated by scripts) ------------------------------
/output/
**/*.rds
**/*.RData
**/*.xlsx
**/*.pdf

# --- Quarto render artefacts ------------------------------------------------
**/*_files/
**/*.html
!docs/**/*.html

# --- Tests (local only, never pushed) ---------------------------------------
/tests/
/ShinyApp/tests/
/R/test.R
www

# --- macOS ------------------------------------------------------------------
.DS_Store

# --- IDE / editor -----------------------------------------------------------
/.posit/
/.vscode/
/positron_settings_fixed.json
.Rhistory
.RData
.Rproj.user/
.Renviron

# --- renv cache (commit renv.lock and optionally .Rprofile) -----------------
/renv/library/
/renv/local/
/renv/staging/
/renv/cellar/
/renv/lock/
/renv/python/
/renv/sandbox/
