# Normalise line endings for text files
* text=auto

# Force LF for source / documentation
*.R text eol=lf
*.qmd text eol=lf
*.md text eol=lf
*.Rmd text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.tsv text eol=lf

# Binary files (do not modify)
*.rds binary
*.RData binary
*.xlsx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
